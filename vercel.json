{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev && node scripts/build-offbeat.mjs --prepare-only",
  "buildCommand": "npm run demo:build",
  "outputDirectory": "examples/brutalist-demo/out",
  "cleanUrls": true,
  "functions": { "api/assistant.mjs": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/session", "destination": "/api/assistant?route=session" },
    { "source": "/api/chat", "destination": "/api/assistant?route=chat" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
