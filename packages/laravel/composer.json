{
  "name": "pagesquire/laravel",
  "description": "Laravel integration for the PageSquire website assistant.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "pagesquire/server": "0.1.0-beta.0",
    "illuminate/support": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "PageSquire\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PageSquire\\Laravel\\PageSquireServiceProvider"
      ]
    }
  }
}
