{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "PageSquire",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "137",
  "permissions": ["debugger", "scripting", "sidePanel", "storage", "tabGroups"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*.localhost/*",
    "https://*.localhost/*",
    "http://*.test/*",
    "https://*.test/*"
  ],
  "background": { "service_worker": "src/worker.js", "type": "module" },
  "side_panel": { "default_path": "src/panel.html" },
  "action": { "default_title": "__MSG_extName__" }
}
