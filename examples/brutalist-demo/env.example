# Server-only OFFBEAT backend configuration. Never use NEXT_PUBLIC_ for secrets.
# Copy to this directory's ignored .env.local for migration; set Vercel env separately.
# No provider, model or credentials are bundled. Use your provider's full HTTPS endpoint.
PAGESQUIRE_PROVIDER_URL=
PAGESQUIRE_MODEL=
PAGESQUIRE_API_KEY=
# Random 32 bytes encoded as 64 hex characters.
PAGESQUIRE_SESSION_SECRET=
# Private visitor unlock code, 12-256 characters; NOT a provider API key.
PAGESQUIRE_DEMO_ACCESS_CODE=
# Required value: supabase-postgres
PAGESQUIRE_STORAGE_DRIVER=
# Supabase Transaction pooler URL. Keep password private and URL-encode credentials.
PAGESQUIRE_DATABASE_URL=
# Exact HTTPS origin, no trailing slash (HTTP allowed only for loopback development).
PAGESQUIRE_PUBLIC_ORIGIN=
# Local CA path OR complete PEM; Vercel must use PEM content, never a local file path.
PAGESQUIRE_DATABASE_CA=
# Optional positive integers; leave unset to use defaults of 100 global / 25 per IP.
# PAGESQUIRE_DAILY_REQUEST_LIMIT=100
# PAGESQUIRE_IP_DAILY_REQUEST_LIMIT=25
