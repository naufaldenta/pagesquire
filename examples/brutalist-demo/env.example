# OFFBEAT is a static, guided-action demo. No environment variables are required.
# Live AI is intentionally locked, even if you fill these values.
# Reserved for a FUTURE server integration; not read by the current application.
# Copy to .env.local for local preparation. Never commit or upload .env.local.
# Never prefix credentials with NEXT_PUBLIC_. Never put secrets in client code.
# Add secrets in Vercel project settings only after a server backend is implemented.

PAGESQUIRE_PROVIDER_URL=
PAGESQUIRE_MODEL=
PAGESQUIRE_API_KEY=
PAGESQUIRE_SESSION_SECRET=
PAGESQUIRE_DEMO_ACCESS_CODE=
# Planned storage: Supabase PostgreSQL, not yet implemented or connected.
# Leave the driver unset until a tested backend adapter is available.
PAGESQUIRE_STORAGE_DRIVER=
# Future server-only Transaction pooler URL from the Supabase Connect dialog.
# Keep the password private; URL-encode special characters in credentials.
# Not read by this static demo. Filling it does not unlock AI chat.
PAGESQUIRE_DATABASE_URL=
